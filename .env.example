# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# --- Site ---
# Production URL, used to build canonical links, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.mwangogichanalegal.com

# --- Contact form (Resend) ---
# Create a key at https://resend.com after verifying the firm's sending domain.
RESEND_API_KEY=
# Address that receives contact-form submissions. Defaults to the firm's
# email in lib/content/firm.ts if left blank.
CONTACT_RECIPIENT_EMAIL=gloria@mwangogichanalegal.com
# Verified "from" address on the Resend domain, e.g. enquiries@mwangogichanalegal.com
CONTACT_FROM_EMAIL=

# --- Sanity CMS (see README "Connecting Sanity") ---
NEXT_PUBLIC_SANITY_PROJECT_ID=gryyptqx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Server-only read token (viewer role) — required because the dataset is
# private. Generate via `npx sanity tokens create "Website Read Token" --role=viewer`.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity -> /api/revalidate webhook. Any random string;
# generate with `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
REVALIDATE_SECRET=

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
